<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Replacement for ADI's FX3USB.dll (MIT). Not strong-named in the original:
        Name=FX3USB  Version=1.0.0.0  (zero-sized public key)
    so no signing games are needed here.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FX3USB</AssemblyName>
    <RootNamespace>FX3USB</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\CyUSB\CyUSB.csproj" />
  </ItemGroup>

</Project>
